{
  "name": "wonder-window-cn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:publication": "node scripts/check-publication-contract.mjs",
    "check:release": "node scripts/check-release-candidate.mjs",
    "rehearse:release": "node scripts/rehearse-release.mjs",
    "rehearse:ready": "node scripts/rehearse-release.mjs --all-ready --date 2099-12-31",
    "test:release-rehearsal": "node scripts/test-release-rehearsal.mjs",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "test:release-manifest": "node scripts/test-release-manifest.mjs",
    "test:release-workflow-safety": "node scripts/test-release-workflow-safety.mjs",
    "check:bundle-privacy": "node scripts/check-bundle-privacy.mjs",
    "rss": "node scripts/generate-rss.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "prebuild": "npm run check:publication && npm run rss && npm run sitemap",
    "build": "vite build && npm run check:bundle-privacy",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
